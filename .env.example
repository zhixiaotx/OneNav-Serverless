# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Optional Sync Configuration via Environment Variables ---
# VITE_SYNC_PROVIDER: 'gist' | 'github_repo' | 'webdav' | 'custom_api' | 'cloudflare_kv' | 'cloudflare_d1' | 'none'
VITE_SYNC_PROVIDER=""
VITE_AUTO_SYNC="true"
VITE_SYNC_INTERVAL_MINUTES="10"

# 1. Gist Sync
VITE_GIST_TOKEN=""
VITE_GIST_ID=""
VITE_GIST_FILENAME="onenav-bookmarks.json"

# 2. GitHub Repository Sync
VITE_GITHUB_REPO_TOKEN=""
VITE_GITHUB_REPO_OWNER=""
VITE_GITHUB_REPO_NAME=""
VITE_GITHUB_REPO_BRANCH="main"
VITE_GITHUB_REPO_PATH="data/bookmarks.json"

# 3. WebDAV Sync
VITE_WEBDAV_URL=""
VITE_WEBDAV_USERNAME=""
VITE_WEBDAV_PASSWORD=""
VITE_WEBDAV_PATH="/onenav/bookmarks.json"

# 4. Custom REST API Sync
VITE_CUSTOM_API_ENDPOINT=""
VITE_CUSTOM_API_SECRET_TOKEN=""

# 5. Cloudflare KV Sync
VITE_CLOUDFLARE_KV_ACCOUNT_ID=""
VITE_CLOUDFLARE_KV_NAMESPACE_ID=""
VITE_CLOUDFLARE_KV_API_TOKEN=""
VITE_CLOUDFLARE_KV_KEY_NAME="onenav_sync"

# 6. Cloudflare D1 Sync
VITE_CLOUDFLARE_D1_ACCOUNT_ID=""
VITE_CLOUDFLARE_D1_DATABASE_ID=""
VITE_CLOUDFLARE_D1_API_TOKEN=""
VITE_CLOUDFLARE_D1_TABLE_NAME="onenav_sync"


